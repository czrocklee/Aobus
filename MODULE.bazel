module(
    name = "aobus",
    version = "0.1.0",
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "rules_cc", version = "0.2.27")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "apple_support", version = "2.11.0")

# Official Python rules for the daily test graph. The host-tools repository
# declares the admitted native interpreter as a platform py_runtime; no
# hermetic Python runtime is downloaded.
bazel_dep(name = "rules_python", version = "1.7.0")

# Reuse upstream code with a selected-LLVM entry and an admitted SDK input seam.
# Retire these API deltas when upstream supports both without a local patch.
# The wrapper also needs its direct <functional> include for C++26; retire that
# include hunk when the upstream pin supplies it.
single_version_override(
    module_name = "apple_support",
    patch_strip = 1,
    patches = ["//bazel:apple_support_llvm.patch"],
)

# Local rules_cc deltas retain private coverage header mappings and make the
# default MSVC exception flag selectable for the SDK-linked lint host. Retire
# each patch when upstream provides the corresponding behavior.
single_version_override(
    module_name = "rules_cc",
    patch_strip = 1,
    patches = [
        "//bazel:rules_cc_coverage_private_headers.patch",
        "//bazel:rules_cc_msvc_exception_handling.patch",
    ],
)

# Reuse Bazel's pinned, precompiled coverage payload without constructing an
# empty Java binary and its unrelated compiler bootstrap on native Linux.
coverage_tools = use_extension("@bazel_tools//tools/test:extensions.bzl", "remote_coverage_tools_extension")
use_repo(coverage_tools, "remote_coverage_tools")

dependencies = use_extension("//bazel:dependencies.bzl", "dependencies")
use_repo(dependencies, "aobus_environment", "aobus_native_deps", "aobus_native_tools", "aobus_test_deps", "aobus_toolchain", "aobus_winui_sdk")

# Bazel resets --compiler in execution transitions. The native execution
# platform selects GCC for Linux tools; target --compiler remains independent.
register_execution_platforms("@aobus_environment//:native_execution")

# The official Python toolchain wraps the admitted native host interpreter
# declared by the host-tools repository; tests run on the installed SDK.
register_toolchains("@aobus_native_tools//:python3_toolchain")

# Loading lint packages imports the existing native LLVM/Clang SDK; bounded
# product targets do not load that dependency.
lint_sdk = use_extension("//bazel/lint:sdk.bzl", "lint_sdk")
use_repo(lint_sdk, "aobus_lint_sdk")

lint_policy = use_extension("//bazel/lint:policy.bzl", "lint_policy")
use_repo(lint_policy, "aobus_lint_policy")
