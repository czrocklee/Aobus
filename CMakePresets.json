{
  "version": 8,
  "configurePresets": [
    {
      "name": "linux-debug",
      "generator": "Ninja",
      "binaryDir": "/tmp/build/${sourceDirName}/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux-release",
      "generator": "Ninja",
      "binaryDir": "/tmp/build/${sourceDirName}/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "profile",
      "generator": "Ninja",
      "binaryDir": "/tmp/build/${sourceDirName}/profile",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-fno-omit-frame-pointer",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "macos-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "$env{AOBUS_LLVM_ROOT}/bin/clang",
        "CMAKE_CXX_COMPILER": "$env{AOBUS_LLVM_ROOT}/bin/clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "$env{AOBUS_MACOS_DEPLOYMENT_TARGET}",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_HOST_TRIPLET": "$env{AOBUS_VCPKG_TRIPLET}",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/vcpkg-triplets",
        "VCPKG_TARGET_TRIPLET": "$env{AOBUS_VCPKG_TRIPLET}"
      }
    },
    {
      "name": "macos-debug",
      "inherits": "macos-base",
      "binaryDir": "/tmp/build/${sourceDirName}/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "macos-release",
      "inherits": "macos-base",
      "binaryDir": "/tmp/build/${sourceDirName}/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-profile",
      "inherits": "macos-base",
      "binaryDir": "/tmp/build/${sourceDirName}/profile",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-fno-omit-frame-pointer"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "windows-debug",
      "inherits": "windows-base",
      "binaryDir": "$env{LOCALAPPDATA}/Aobus/build/cmake-preset/${sourceDirName}/windows-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-tidy",
      "inherits": "windows-release",
      "binaryDir": "$env{LOCALAPPDATA}/Aobus/build/cmake-preset/${sourceDirName}/windows-tidy",
      "cacheVariables": {
        "AOBUS_BUILD_LINT_PLUGIN": "ON"
      }
    },
    {
      "name": "windows-release",
      "inherits": "windows-base",
      "binaryDir": "$env{LOCALAPPDATA}/Aobus/build/cmake-preset/${sourceDirName}/windows-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-winui",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "$env{LOCALAPPDATA}/Aobus/build/cmake-preset/${sourceDirName}/windows-winui",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": "ON",
        "AOBUS_BUILD_CLI": "OFF",
        "AOBUS_BUILD_GTK": "OFF",
        "AOBUS_BUILD_TESTS": "OFF",
        "AOBUS_BUILD_TOOLS": "OFF",
        "AOBUS_BUILD_LINT_PLUGIN": "OFF",
        "AOBUS_BUILD_TUI": "OFF",
        "AOBUS_BUILD_WINUI": "ON"
      }
    }
  ]
}
