{
  "schemaVersion": 2,
  "leadResolver": "nix",
  "dependencies": {
    "boost": {
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "policy": {
        "kind": "exact",
        "version": "1.91.0"
      },
      "nix": {
        "attribute": "boost"
      },
      "vcpkg": {
        "strategy": "scoped-registry",
        "ports": [
          "boost-algorithm",
          "boost-asio",
          "boost-container",
          "boost-endian",
          "boost-filesystem",
          "boost-hash2",
          "boost-headers",
          "boost-interprocess",
          "boost-lockfree",
          "boost-pfr",
          "boost-process",
          "boost-unordered"
        ]
      }
    },
    "fast-float": {
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "policy": {
        "kind": "exact",
        "version": "8.2.10"
      },
      "nix": {
        "attribute": "aobus-fast-float"
      },
      "vcpkg": {
        "strategy": "baseline",
        "ports": [
          "fast-float"
        ]
      }
    },
    "ftxui": {
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "policy": {
        "kind": "exact",
        "version": "7.0.3"
      },
      "nix": {
        "attribute": "ftxui"
      },
      "vcpkg": {
        "strategy": "baseline",
        "ports": [
          "ftxui"
        ]
      }
    },
    "icu": {
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "policy": {
        "kind": "exact",
        "version": "78.3"
      },
      "nix": {
        "attribute": "icu78"
      },
      "vcpkg": {
        "strategy": "baseline",
        "ports": [
          "icu"
        ]
      },
      "capabilities": [
        "unicode-17.0",
        "resource-bundles",
        "classic-message-format",
        "locale-collation",
        "script-transliteration"
      ]
    },
    "lmdb": {
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "policy": {
        "kind": "exact",
        "version": "1.0.1"
      },
      "nix": {
        "attribute": "aobus-lmdb"
      },
      "vcpkg": {
        "strategy": "baseline",
        "ports": [
          "lmdb"
        ]
      }
    },
    "spdlog": {
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "policy": {
        "kind": "exact",
        "version": "1.17.0"
      },
      "nix": {
        "attribute": "spdlog"
      },
      "vcpkg": {
        "strategy": "baseline",
        "ports": [
          "spdlog"
        ]
      },
      "capabilities": [
        "spdlog-std-format",
        "spdlog-no-external-fmt"
      ]
    },
    "windows-app-sdk": {
      "platforms": [
        "windows"
      ],
      "policy": {
        "kind": "exact",
        "version": "2.4.0"
      },
      "nuget": {
        "package": "Microsoft.WindowsAppSDK",
        "lock": "app/windows-winui/packages.config"
      },
      "runtime": {
        "packageName": "Microsoft.WindowsAppRuntime.2",
        "version": "2.4.0.0",
        "architecture": "x64",
        "installerUrl": "https://aka.ms/windowsappsdk/2.4/2.4.0/windowsappruntimeinstall-x64.exe",
        "sha256": "851c35b0b0a59ce4c55f9171f601193322fc3413143b0dc3390ea11e14cfa7fc"
      }
    },
    "cppwinrt": {
      "platforms": [
        "windows"
      ],
      "policy": {
        "kind": "exact",
        "version": "3.0.260715.1"
      },
      "nuget": {
        "package": "Microsoft.Windows.CppWinRT",
        "lock": "app/windows-winui/packages.config"
      }
    }
  },
  "exceptions": []
}
