{
  "schemaVersion": 2,
  "leadResolver": "nix",
  "dependencies": {
    "boost": {
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "policy": {
        "kind": "exact",
        "version": "1.89.0"
      },
      "nix": {
        "attribute": "boost"
      },
      "vcpkg": {
        "strategy": "scoped-registry",
        "ports": [
          "boost-algorithm",
          "boost-asio",
          "boost-container",
          "boost-endian",
          "boost-filesystem",
          "boost-hash2",
          "boost-headers",
          "boost-interprocess",
          "boost-lockfree",
          "boost-pfr",
          "boost-process",
          "boost-unordered"
        ]
      },
      "cmake": {
        "package": "Boost",
        "targets": [
          "Boost::headers",
          "Boost::process",
          "Boost::filesystem"
        ]
      }
    },
    "fast-float": {
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "policy": {
        "kind": "exact",
        "version": "8.2.10"
      },
      "nix": {
        "attribute": "aobus-fast-float"
      },
      "vcpkg": {
        "strategy": "baseline",
        "ports": [
          "fast-float"
        ]
      },
      "cmake": {
        "package": "FastFloat",
        "targets": [
          "FastFloat::fast_float"
        ]
      }
    },
    "ftxui": {
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "policy": {
        "kind": "exact",
        "version": "6.1.9"
      },
      "nix": {
        "attribute": "ftxui"
      },
      "vcpkg": {
        "strategy": "override",
        "ports": [
          "ftxui"
        ]
      },
      "cmake": {
        "package": "ftxui",
        "requiredWhen": "AOBUS_BUILD_TUI",
        "targets": [
          "ftxui::screen",
          "ftxui::dom",
          "ftxui::component"
        ]
      }
    },
    "icu": {
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "policy": {
        "kind": "exact",
        "version": "78.3"
      },
      "nix": {
        "attribute": "icu78"
      },
      "vcpkg": {
        "strategy": "baseline",
        "ports": [
          "icu"
        ]
      },
      "cmake": {
        "package": "ICU",
        "targets": [
          "ICU::i18n",
          "ICU::uc",
          "ICU::data"
        ]
      },
      "capabilities": [
        "unicode-17.0",
        "resource-bundles",
        "classic-message-format",
        "locale-collation",
        "script-transliteration"
      ]
    },
    "spdlog": {
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "policy": {
        "kind": "exact",
        "version": "1.17.0"
      },
      "nix": {
        "attribute": "spdlog"
      },
      "vcpkg": {
        "strategy": "baseline",
        "ports": [
          "spdlog"
        ]
      },
      "cmake": {
        "package": "spdlog",
        "targets": [
          "spdlog::spdlog"
        ]
      },
      "capabilities": [
        "spdlog-std-format",
        "spdlog-no-external-fmt"
      ]
    },
    "windows-app-sdk": {
      "platforms": [
        "windows"
      ],
      "policy": {
        "kind": "exact",
        "version": "2.4.0"
      },
      "nuget": {
        "package": "Microsoft.WindowsAppSDK",
        "lock": "app/windows-winui/packages.config"
      },
      "msbuild": {
        "requiredWhen": "AOBUS_BUILD_WINUI"
      },
      "runtime": {
        "packageName": "Microsoft.WindowsAppRuntime.2",
        "version": "2.4.0.0",
        "architecture": "x64",
        "installerUrl": "https://aka.ms/windowsappsdk/2.4/2.4.0/windowsappruntimeinstall-x64.exe",
        "sha256": "851c35b0b0a59ce4c55f9171f601193322fc3413143b0dc3390ea11e14cfa7fc"
      }
    },
    "cppwinrt": {
      "platforms": [
        "windows"
      ],
      "policy": {
        "kind": "exact",
        "version": "3.0.260715.1"
      },
      "nuget": {
        "package": "Microsoft.Windows.CppWinRT",
        "lock": "app/windows-winui/packages.config"
      },
      "msbuild": {
        "requiredWhen": "AOBUS_BUILD_WINUI"
      }
    }
  },
  "exceptions": []
}
