{
  "name": "aobus",
  "version-string": "0.1.0",
  "default-features": [
    "tests",
    "frontends"
  ],
  "dependencies": [
    "alac",
    "boost-algorithm",
    "boost-asio",
    "boost-container",
    "boost-endian",
    "boost-filesystem",
    "boost-hash2",
    "boost-headers",
    "boost-interprocess",
    "boost-lockfree",
    "boost-pfr",
    "boost-process",
    "boost-unordered",
    {
      "name": "date",
      "platform": "osx",
      "$reason": "libc++ omits the C++20 time-zone database; remove with doc/development/macos-portability.md entry 10."
    },
    "c4core",
    "fdk-aac",
    "fast-float",
    "foonathan-lexy",
    "gsl-lite",
    {
      "name": "icu",
      "default-features": false,
      "features": [
        "tools"
      ]
    },
    {
      "name": "gperf",
      "host": true
    },
    {
      "name": "python3",
      "host": true,
      "platform": "windows"
    },
    "libflac",
    "lmdb",
    "mimalloc",
    "mpg123",
    "opus",
    "ryml",
    {
      "name": "spdlog",
      "default-features": false,
      "features": [
        "tz-offset"
      ],
      "$reason": "Disabling the default fmt feature makes the port build spdlog with SPDLOG_USE_STD_FORMAT, matching the Linux build."
    },
    "xxhash"
  ],
  "overrides": [
    {
      "name": "cli11",
      "version": "2.7.2"
    },
    {
      "name": "catch2",
      "version": "3.16.1"
    },
    {
      "name": "python3",
      "version": "3.14.10"
    },
    {
      "name": "mpdecimal",
      "version": "4.0.1"
    }
  ],
  "features": {
    "frontends": {
      "description": "Dependencies needed by the CLI and terminal frontends.",
      "dependencies": [
        "cli11",
        "ftxui",
        "stb"
      ]
    },
    "tests": {
      "description": "Dependencies needed to build Aobus unit tests.",
      "dependencies": [
        "catch2",
        "fakeit"
      ]
    }
  }
}
