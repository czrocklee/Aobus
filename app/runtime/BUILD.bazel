load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:private"])

# Keep the diagnostic object separate, including for the minimal fatal probe.
cc_library(
    name = "prepared_next_contract",
    srcs = ["playback/PreparedNextContract.cpp"],
    hdrs = ["playback/PreparedNextContract.h"],
    include_prefix = "runtime",
    strip_include_prefix = ".",
    implementation_deps = ["//lib/utility:utility"],
    linkstatic = True,
    visibility = [
        "//app/runtime:__pkg__",
        "//test:__pkg__",
    ],
)

# Declared virtual runtime/... paths serve implementation and test consumers
# without exporting app/ as a broad include root or depending on the archive.
cc_library(
    name = "private_headers",
    hdrs = glob(
        ["**/*.h"],
        exclude = ["playback/PreparedNextContract.h"],
    ),
    include_prefix = "runtime",
    strip_include_prefix = ".",
    deps = [
        ":prepared_next_contract",
        "//app/include:runtime_headers",
        "//include:async_headers",
        "//include:audio_headers",
        "//include:library_headers",
        "//include:media_headers",
        "//include:query_headers",
        "//include:utility_headers",
        "@aobus_native_deps//:boost",
    ],
)

