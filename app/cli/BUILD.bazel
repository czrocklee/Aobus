load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//bazel:windows_utf8_manifest.bzl", "WINDOWS_UTF8_LINKER_INPUTS", "WINDOWS_UTF8_LINKOPTS")

package(default_visibility = ["//visibility:private"])

cc_library(
    name = "cli",
    srcs = [
        "CliRuntime.cpp",
        "CommandError.cpp",
        "DumpOutput.cpp",
        "InitCommand.cpp",
        "LibCommand.cpp",
        "ListCommand.cpp",
        "Output.cpp",
        "QueryHelp.cpp",
        "Run.cpp",
        "ScanCommand.cpp",
        "ScanOutput.cpp",
        "TagCommand.cpp",
        "TrackCommand.cpp",
        "TrackSelection.cpp",
    ],
    hdrs = [
        "BooleanFlag.h",
        "CliRuntime.h",
        "CommandError.h",
        "CommandRegistrations.h",
        "DryRunFlag.h",
        "DumpOutput.h",
        "ListCommand.h",
        "Output.h",
        "QueryHelp.h",
        "Run.h",
        "ScanCommand.h",
        "ScanOutput.h",
        "TrackSelection.h",
    ],
    includes = ["."],
    linkstatic = True,
    implementation_deps = ["//include:app_version_header"],
    visibility = ["//test:__pkg__"],
    deps = [
        "//app/runtime:runtime",
        "//lib:ao",
        "@aobus_native_deps//:boost",
        "@aobus_native_deps//:cli11",
    ],
)

cc_binary(
    name = "aobus",
    srcs = ["main.cpp"],
    additional_linker_inputs = WINDOWS_UTF8_LINKER_INPUTS,
    linkopts = WINDOWS_UTF8_LINKOPTS,
    linkstatic = True,
    visibility = ["//visibility:public"],
    deps = [":cli", "@aobus_native_deps//:mimalloc"],
)
