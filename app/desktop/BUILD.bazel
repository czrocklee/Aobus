load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:private"])

# ao_desktop_launch: shared pure desktop lifecycle rules and process mechanism.
# Toolkit registration, windows, dispatchers, stores, and diagnostics stay in
# the GTK, WinUI, and AppKit composition roots.
cc_library(
    name = "desktop_launch",
    srcs = [
        "DetachedProcessLauncher.cpp",
        "LibraryPath.cpp",
        "LibraryStartupPlanner.cpp",
        "LibrarySuccessorProtocol.cpp",
        "LibrarySwitch.cpp",
    ],
    linkstatic = True,
    implementation_deps = ["@aobus_native_deps//:boost_process"],
    # The shared desktop launch layer builds for every shipping desktop host;
    # the AppKit frontend links it on macOS like GTK and WinUI do.
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:macos": [],
        "@platforms//os:windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//app/include:desktop_headers",
        "//lib/utility:utility",
    ],
    visibility = [
        "//app/linux-gtk:__pkg__",
        "//app/macos-appkit:__pkg__",
        "//app/windows-winui:__pkg__",
        "//test:__pkg__",
    ],
)
