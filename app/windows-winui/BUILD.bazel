# These portable model rules compile on every host: none needs WinRT,
# the WinUI SDK, generated XAML or the native frontend's forced include.
MODEL_SOURCES = [
    "app/DesktopOutputSelection.cpp",
    "app/DesktopSettingsYamlSchema.cpp",
    "app/DestructiveLibraryRestart.cpp",
