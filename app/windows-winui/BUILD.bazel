# XAML and C++/WinRT generation. CcInfo keeps project-generated headers
# distinct from external SDK projections. The "cpp" output group supplies
# wrappers for the SDK's four standalone generated translation units. Only the
# XAML, paired headers and IDL are authored inputs to the generator.
winui_codegen(
    name = "generated",
    codebehind_hdrs = [
        "App.xaml.h",
        "MainWindow.xaml.h",
    ],
    idl = "Project.idl",
    language_standard = MSVC_MSBUILD_LANGUAGE_STANDARD,
    target_compatible_with = ["@platforms//os:windows"],
    # The stream adapter shares this product's locked C++/WinRT projection.
    # The analysis test reads the declared roots without building the generator.
    visibility = [
        "//app/windows:__pkg__",
        "//test/winui/projection:__pkg__",
    ],
    xaml = [
        "App.xaml",
        "MainWindow.xaml",
    ],
)

# The generated standalone translation units enter compilation only through
# this forwarding filegroup. Other generated fragments are included by their
# authored or generated owners and must never be compiled separately.
filegroup(
    name = "generated_cpp",
    srcs = [":generated"],
    output_group = "cpp",
)

