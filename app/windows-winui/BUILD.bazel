MODEL_HEADERS = glob(
    ["include/ao/winui/**/*.h"],
    exclude = ["include/ao/winui/WinUiErrorBoundary.h"],
)

# Preserve the source-private include used by the admission tests without
# exporting all of app/ as an include root.
cc_library(
    name = "admission_headers",
    hdrs = ["app/DispatcherQueueAdmission.h"],
    include_prefix = "windows-winui",
    strip_include_prefix = ".",
    deps = ["//bazel:compile_contract"],
)

cc_library(
    name = "model",
    srcs = MODEL_SOURCES,
    hdrs = MODEL_HEADERS,
    includes = ["include"],
    linkstatic = True,
    implementation_deps = [
        "//app/i18n:i18n",
        "//include:yaml_headers",
        "//lib/utility:unicode_text",
    ],
    deps = [
        ":admission_headers",
        "//app/uimodel:uimodel",
        "@aobus_native_deps//:rapidyaml",
    ],
    visibility = ["//test:__pkg__"],
)

# Native diagnostic handling is also consumed by core tests. Share the
# product's governed projection, not the full frontend or a second WinRT ABI.
cc_library(
    name = "error_boundary",
    srcs = ["platform/WinUiErrorBoundary.cpp"],
    hdrs = ["include/ao/winui/WinUiErrorBoundary.h"],
    includes = ["include"],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        ":generated",
        "//app/runtime:runtime",
    ],
    visibility = ["//test:__pkg__"],
)

# Controlled source runfiles for existing shell-document/wiring tests. These
# are observations of authored inputs, not a checkout-root runtime fallback.
filegroup(
    name = "model_test_inputs",
    srcs = [
        "CMakeLists.txt",
        "MainWindow.xaml.cpp",
        "layout/ShellBuilder.cpp",
        "layout/windows_classic_layout.yaml",
        "layout/windows_modern_layout.yaml",
    ],
    testonly = True,
    visibility = ["//test:__pkg__"],
)

filegroup(
    name = "native_test_inputs",
    srcs = glob(["**/*.cpp", "**/*.h", "**/*.xaml", "**/*.yaml"]),
    testonly = True,
    visibility = ["//test:__pkg__"],
)

# WinUI code generation: the XAML compiler, MIDL projection, and the generated
# header tree. The rule's default outputs and CcInfo expose the generated
# headers; the "cpp" output group supplies the standalone generated
# wrappers for the SDK's four standalone generated translation units.
winui_codegen(
    name = "generated",
    srcs = WINUI_SOURCES,
    hdrs = WINUI_HEADERS,
    idl = "Project.idl",
    xaml = [
        "App.xaml",
        "MainWindow.xaml",
    ],
    target_compatible_with = ["@platforms//os:windows"],
    # The stream adapter shares this product's locked C++/WinRT projection.
    # This grants generated headers only, never a frontend binary dependency.
    visibility = ["//app/windows:__pkg__"],
)

# The generated standalone translation units enter compilation only through
# this forwarding filegroup. Other generated fragments are included by their
# authored or generated owners and must never be compiled separately.
filegroup(
    name = "generated_cpp",
    srcs = [":generated"],
    output_group = "cpp",
)

# aobus-winui-lib: the native remainder over the shared model and diagnostic
# owners. Keep WINUI_SOURCES complete for SDK generation and CMake parity;
# filter only the compilation inputs so no product unit is compiled twice.
cc_library(
    name = "winui",
    srcs = [source for source in WINUI_SOURCES if source not in MODEL_SOURCES + ["platform/WinUiErrorBoundary.cpp"]] + [":generated_cpp"],
    hdrs = [header for header in WINUI_HEADERS if header not in MODEL_HEADERS + [
        "app/DispatcherQueueAdmission.h",
        "include/ao/winui/WinUiErrorBoundary.h",
    ]],
    # CMake force-includes pch.h through target_precompile_headers. Preserve
    # its framework/generated-type declarations without a second PCH cache.
    copts = [
        "/bigobj",
        "/FIpch.h",
    ],
    includes = [
        ".",
        "include",
    ],
    linkopts = [
        "runtimeobject.lib",
        "shell32.lib",
    ],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:windows"],
    implementation_deps = [
        "//app/i18n:completion",
        "//app/i18n:i18n",
        "//app/i18n:ordering",
        "//lib/utility:unicode_text",
    ],
    deps = [
        ":error_boundary",
        ":generated",
        ":model",
        "//app/desktop:desktop_launch",
        "//app/runtime:runtime",
        "//app/uimodel:uimodel",
        "//app/windows:windows_platform",
        "@aobus_native_deps//:rapidyaml",
        "@aobus_winui_sdk//:headers",
    ],
)

# Deployed WinUI resources: compiled XAML (App.xbf, MainWindow.xbf), the merged
# Aobus.pri, the catalog resw intermediates, and the packaged content assets.
# The assets attr carries the brand and no-cover artwork; the shell layout
# YAML files are owned by this package and declared explicitly.
winui_resources(
    name = "resources",
    assets = ["//asset:winui_assets"],
    catalog = "//app/i18n:catalog_intermediates",
    generated = ":generated",
    srcs = [
        "layout/windows_classic_layout.yaml",
        "layout/windows_modern_layout.yaml",
    ],
    target_compatible_with = ["@platforms//os:windows"],
)

# The final shipping link. App.xaml.g.hpp defines wWinMain in the generated
# XamlTypeInfo object; the Unicode CRT entry extracts it from the real winui
# archive without whole-archiving duplicate XAML metadata providers. The GUI
# manifest already owns UTF-8, DPI and long paths; do not merge the separate
# console assembly identity into it. MRT requires the canonical Aobus name.
cc_binary(
    name = "Aobus",
    srcs = [],
    additional_linker_inputs = ["app.manifest"],
    linkopts = [
        "/MANIFEST:EMBED",
        "/ENTRY:wWinMainCRTStartup",
        "/MANIFESTINPUT:$(location app.manifest)",
        "/SUBSYSTEM:WINDOWS",
        "runtimeobject.lib",
        "shell32.lib",
    ],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        ":winui",
        "@aobus_winui_sdk//:bootstrap",
    ],
)

# Independently entered CMake probes, never switches on the shipping app.
# All reuse the actual archive, generated projection and catalog/PRI owner.
# In particular localization pulls StringResources from :winui, not a second
# compilation of that product unit. GUI probes remain explicitly manual.
winui_probe(
    name = "ao_winui_localization_probe",
    srcs = ["//test:helper/WinUiLocalizationProbe.cpp"],
    console = True,
    deps = ["//app/i18n:i18n"],
)

winui_probe(
