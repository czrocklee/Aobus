# SDK's selected bootstrap payload, not a launcher around a CMake build.
winui_app(
    name = "aobus-winui",
    resources = ":resources",
    runtime = "@aobus_winui_sdk//:runtime",
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//visibility:public"],
    deps = [":Aobus"],
)
