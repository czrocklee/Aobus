<Window
    x:Class="Aobus.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Aobus"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid x:Name="RootGrid" SizeChanged="OnRootSizeChanged">
        <Grid.Resources>
            <Style x:Key="ChromeLessButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="8" />
            </Style>
            <Style x:Key="ColumnHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeLessButtonStyle}">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>
            <Style x:Key="TrackListItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
            </Style>
            <Style x:Key="InspectorSectionHeaderStyle" TargetType="Button" BasedOn="{StaticResource ChromeLessButtonStyle}">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
            <!--
                Appearance for the built-in Windows preset documents. A node
                reaches one of these through `styleKey`, which carries geometry,
                spacing, and typography only: colour arrives through `surface`,
                which the shell resolves against the loaded theme while it
                builds the generation. Each TargetType is the element the
                Windows layout catalog says the node constructs, so a rename on
                either side fails the frame-resource test rather than the build.
            -->
            <Style x:Key="ModernTitleBarStyle" TargetType="Grid">
                <Setter Property="Padding" Value="16,0" />
                <!-- An unpainted title bar is not hit-testable, and the caption drag region needs the hits. -->
                <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style x:Key="ModernLibraryPathStyle" TargetType="TextBlock">
                <!-- The right inset keeps the path clear of the caption buttons. -->
                <Setter Property="Margin" Value="14,0,150,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Opacity" Value="0.55" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="ModernTrackControlsStyle" TargetType="Grid">
                <Setter Property="Padding" Value="12,8" />
            </Style>
            <Style x:Key="ModernSubduedTextStyle" TargetType="TextBlock">
                <Setter Property="Opacity" Value="0.55" />
            </Style>
            <!--
                What a revealed inspector overlay is opaque with, under
                whatever surface the preset paints on the pane itself. A card
                surface is a tint meant to be layered on a page - Fluent's own
                is 70% white - which is right for a pane inside the workspace
                and is the track rows reading through the fields once the pane
                floats over them. Declared here rather than in a preset because
                it is not the pane's appearance but the condition of it being
                legible at all, and both shells need it whatever they paint.
            -->
            <SolidColorBrush
                x:Key="InspectorOverlayFillBrush"
                Color="{ThemeResource SolidBackgroundFillColorSecondary}" />
            <Style x:Key="ModernInspectorStyle" TargetType="Grid">
                <Setter Property="Margin" Value="0,12,12,12" />
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
            </Style>
            <Style x:Key="ModernInspectorCoverStyle" TargetType="Border">
                <!--
                    Width comes from the pane, which the user resizes; the cap
                    keeps the cover from swallowing a wide inspector, and the
                    component answers whatever width it ends up with by
                    matching its height to it.
                -->
                <Setter Property="Margin" Value="16,16,16,12" />
                <Setter Property="MaxWidth" Value="320" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="ModernNowPlayingStyle" TargetType="Grid">
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
            </Style>
            <Style x:Key="ModernNowPlayingRowStyle" TargetType="Grid">
                <!--
                    The strip pads its content row rather than itself, so the
                    seek overlay above still reaches both edges of the window.
                -->
                <Setter Property="Padding" Value="16,8" />
            </Style>
            <Style x:Key="ModernSeekOverlayStyle" TargetType="Slider">
                <!--
                    The overlay straddles the strip's top edge instead of taking
                    a band out of it: the negative margins hang it over the
                    boundary, leaving the row it occupies 10px tall.
                -->
                <Setter Property="Margin" Value="-10,-10,-10,0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Canvas.ZIndex" Value="20" />
            </Style>
            <Style x:Key="ModernTimeLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Opacity" Value="0.55" />
            </Style>
            <Style x:Key="ClassicPlaybackStripStyle" TargetType="Grid">
                <Setter Property="Padding" Value="6" />
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Style>
            <!--
                The rounding the Classic chrome takes. A theme that asks for
                retro chrome squares it off, which the shell does by replacing
                this value and rebuilding rather than by reaching for the bars
                the document built.
            -->
            <CornerRadius x:Key="ClassicChromeCornerRadius">4</CornerRadius>
            <Style x:Key="ClassicToolbarStyle" TargetType="Grid">
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,1" />
                <Setter Property="CornerRadius" Value="{ThemeResource ClassicChromeCornerRadius}" />
            </Style>
            <Style x:Key="ClassicInspectorStyle" TargetType="Grid">
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1,0,0,0" />
            </Style>
            <Style x:Key="ClassicInspectorCoverStyle" TargetType="Border">
                <!--
                    The cap is tighter than Modern's and the radius is the
                    chrome's own: a property sheet shows a thumbnail of what it
                    describes, not a hero image, so the rows stay on screen at
                    the pane widths Classic is usually given.
                -->
                <Setter Property="Margin" Value="10,10,10,8" />
                <Setter Property="MaxWidth" Value="200" />
                <Setter Property="CornerRadius" Value="{ThemeResource ClassicChromeCornerRadius}" />
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="ClassicStatusBarStyle" TargetType="Grid">
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
                <Setter Property="CornerRadius" Value="{ThemeResource ClassicChromeCornerRadius}" />
            </Style>

            <!--
                Seek slider chrome, one dictionary per presentation. These are
                WinUI's own template keys, so they are kept behind a key of
                their own and merged into the one slider that asked for them
                rather than published to the window, where every slider in the
                shell would take them.
            -->
            <ResourceDictionary x:Key="ModernSeekOverlayResources">
                <ControlTemplate x:Key="ModernSeekThumbTemplate" TargetType="Thumb">
                    <Ellipse
                        Width="20"
                        Height="20"
                        Fill="{TemplateBinding Background}" />
                </ControlTemplate>
                <x:Double x:Key="SliderTrackThemeHeight">2</x:Double>
                <x:Double x:Key="SliderHorizontalHeight">20</x:Double>
                <x:Double x:Key="SliderPreContentMargin">0</x:Double>
                <x:Double x:Key="SliderPostContentMargin">0</x:Double>
                <x:Double x:Key="SliderHorizontalThumbWidth">20</x:Double>
                <x:Double x:Key="SliderHorizontalThumbHeight">20</x:Double>
                <CornerRadius x:Key="SliderTrackCornerRadius">0</CornerRadius>
                <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="Transparent" />
                <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="SliderContainerBackground" Color="Transparent" />
                <SolidColorBrush x:Key="SliderContainerBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="SliderContainerBackgroundPressed" Color="Transparent" />
                <SolidColorBrush x:Key="SliderContainerBackgroundDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="SliderTrackFillPressed" Color="Transparent" />
                <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="Transparent" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="ClassicSeekInlineResources">
                <x:Double x:Key="SliderTrackThemeHeight">6</x:Double>
                <x:Double x:Key="SliderHorizontalThumbWidth">14</x:Double>
                <x:Double x:Key="SliderHorizontalThumbHeight">14</x:Double>
            </ResourceDictionary>

            <DataTemplate x:Key="TrackCellTemplate" x:DataType="local:TrackCellItem">
                <Grid Width="{x:Bind Width}" Height="32" Padding="8,0">
                    <TextBlock
                        Text="{x:Bind Text}"
                        TextAlignment="{x:Bind Alignment}"
                        TextTrimming="CharacterEllipsis"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="TrackHeaderCellTemplate" x:DataType="local:TrackCellItem">
                <Grid Width="{x:Bind Width}" Height="32">
                    <Button
                        Width="{x:Bind Width}"
                        Tag="{x:Bind FieldId}"
                        Click="OnColumnHeaderClicked"
                        HorizontalContentAlignment="Stretch"
                        Style="{StaticResource ColumnHeaderButtonStyle}">
                        <Button.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    x:Uid="MoveColumnLeftMenuItem"
                                    Text="Move left"
                                    Tag="{x:Bind FieldId}"
                                    Click="OnColumnMoveLeftClicked" />
                                <MenuFlyoutItem
                                    x:Uid="MoveColumnRightMenuItem"
                                    Text="Move right"
                                    Tag="{x:Bind FieldId}"
                                    Click="OnColumnMoveRightClicked" />
                            </MenuFlyout>
                        </Button.ContextFlyout>
                        <TextBlock
                            Text="{x:Bind Text}"
                            TextAlignment="{x:Bind Alignment}"
                            TextTrimming="CharacterEllipsis"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center" />
                    </Button>
                    <Thumb
                        Width="7"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        Tag="{x:Bind FieldId}"
                        DragCompleted="OnColumnResizeCompleted" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="TrackRowTemplate" x:DataType="local:TrackRowItem">
                <StackPanel>
                    <Grid
                        Height="{x:Bind GroupHeight}"
                        Padding="10,8"
                        ColumnSpacing="12"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="48"
                            Height="48"
                            CornerRadius="6"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <Grid
                                DataContextChanged="OnGroupCoverDataContextChanged"
                                Loaded="OnGroupCoverLoaded"
                                Unloaded="OnGroupCoverUnloaded">
                                <Grid />
                                <Image Stretch="UniformToFill" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Artist}" FontSize="12" Opacity="0.72" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Album}" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Opacity="0.55">
                            <TextBlock Text="{x:Bind GroupCount}" />
                            <TextBlock x:Uid="GroupTracksSuffix" Text="tracks" />
                        </StackPanel>
                    </Grid>
                    <ItemsControl
                        Height="{x:Bind RowHeight}"
                        ItemsSource="{x:Bind Cells}"
                        ItemTemplate="{StaticResource TrackCellTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </DataTemplate>
            <!--
                A `TreeView` renders its node content through an item template
                and falls back to the content's type name without one, so the
                navigation tree is given this rather than left to print
                `TreeViewNode` on every row.
            -->
            <DataTemplate x:Key="NavigationTreeNodeTemplate">
                <ContentPresenter
                    Content="{Binding Content}"
                    HorizontalContentAlignment="Stretch" />
            </DataTemplate>
        </Grid.Resources>

        <!--
            The single region the shell attaches one document-built generation
            at a time to. It is the window's whole client area: a preset owns
            the title bar as well, so the frame keeps no band of its own.
        -->
        <Border x:Name="ShellLayoutHost" />
    </Grid>
</Window>
