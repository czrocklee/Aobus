# Tests retain both the frontend's authored app/... paths and its existing
# linux-gtk/... include spelling without exporting the whole app directory.
cc_library(
    name = "test_headers",
    testonly = True,
    hdrs = glob(["**/*.h"]),
    include_prefix = "linux-gtk",
    strip_include_prefix = ".",
    target_compatible_with = GTK_COMPATIBILITY,
    visibility = ["//test:__pkg__"],
    deps = [
        ":gtk",
        "@aobus_native_deps//:gtkmm",
    ],
)

