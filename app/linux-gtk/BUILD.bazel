load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load(":gresource.bzl", "gresource_c")

package(default_visibility = ["//visibility:private"])

GTK_COMPATIBILITY = select({
    "//bazel:linux_gtk_enabled": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

config_setting(
    name = "gtk_x86_64_cpu",
    constraint_values = ["@platforms//cpu:x86_64"],
)

# The SDK's gtkmm-4.0 pkg-config Cflags contain exactly these x86_64 SSE
# options. GTK-interface consumers restate that admitted consumer obligation
# locally instead of forwarding the interface's flags blindly.
GTK_HEADER_COPTS = select({
    ":gtk_x86_64_cpu": [
        "-mfpmath=sse",
        "-msse",
        "-msse2",
    ],
    "//conditions:default": [],
})

# GResource bundle: the committed XML stays the single authority for membership
# and aliases. The declared inputs overapproximate the referenced CSS, YAML, SVG,
# and license files with package-local globs and a bounded asset filegroup.
gresource_c(
    name = "generated_resources",
    srcs = ["app.css"] + glob([
        "css/*.css",
        "layout/*.yaml",
    ]) + ["//asset:gresource_files"],
    out = "resources.c",
    target_compatible_with = GTK_COMPATIBILITY,
    xml = "aobus.gresource.xml",
)

# Standard C compilation of the generated bundle, kept separate so only this
# target carries the -Wno-overlength-strings suppression the CMake build sets.
cc_library(
    name = "resources",
    srcs = [":generated_resources"],
    copts = GTK_HEADER_COPTS + ["-Wno-overlength-strings"],
    implementation_deps = ["@aobus_native_deps//:gtkmm"],
    linkstatic = True,
    target_compatible_with = GTK_COMPATIBILITY,
)

