load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel/lint:canary.bzl", "lint_cache_canaries")
load("//bazel/lint:fixtures.bzl", "lint_fixture_test")
load("//bazel/lint:graph.bzl", "lint_graph_test")
load(":replay_launcher_test.bzl", "replay_launcher_py_test")

package(default_visibility = ["//visibility:public"])

lint_graph_test(
    name = "production_lint",
    size = "large",
    tags = ["aobus-lint-sdk-host"],
)

filegroup(
    name = "fixtures",
    srcs = glob(["fixture/**"]),
)

# These independent native contexts test cacheable findings, not shipping code.
# Request their lint aspect only: compiling the error control is deliberately invalid.
lint_cache_canaries(
    name = "cache_inputs",
    clean = "CacheClean.cpp",
    error = "CacheError.cpp",
    header = "CacheControl.h",
    header_template = "CacheControl.h.in",
    tags = ["manual"],
    warning = "CacheWarning.cpp",
)

cc_library(
    name = "cache_warning",
    testonly = True,
    srcs = [":CacheWarning.cpp"],
    hdrs = [":CacheControl.h"],
    features = [
        "-aobus_warnings",
        "-treat_warnings_as_errors",
    ],
    tags = ["manual"],
    deps = ["//bazel:compile_contract"],
)

cc_library(
    name = "cache_clean",
    testonly = True,
    srcs = [":CacheClean.cpp"],
    hdrs = [":CacheControl.h"],
    features = [
        "-aobus_warnings",
        "-treat_warnings_as_errors",
    ],
    tags = ["manual"],
    deps = ["//bazel:compile_contract"],
)

cc_library(
    name = "cache_error",
    testonly = True,
    srcs = [":CacheError.cpp"],
    hdrs = [":CacheControl.h"],
    features = [
        "-aobus_warnings",
        "-treat_warnings_as_errors",
    ],
    tags = ["manual"],
    deps = ["//bazel:compile_contract"],
)

# The preamble intentionally includes the paired header in source mode. Its
# declarations/macros must remain available in the physical-header replay.
cc_library(
    name = "header_replay",
    testonly = True,
    srcs = ["HeaderReplay.cpp"],
    hdrs = [
        "HeaderReplay.h",
        "HeaderReplayDetail.h",
        "HeaderReplayPreamble.h",
    ],
    copts = select({
        "@platforms//os:windows": ["/FItest/lint/HeaderReplayPreamble.h"],
        "//conditions:default": [
            "-include",
            "test/lint/HeaderReplayPreamble.h",
        ],
    }),
    features = [
        "-aobus_warnings",
        "-treat_warnings_as_errors",
    ],
    tags = ["manual"],
    deps = ["//bazel:compile_contract"],
)

# Publish the header under a different include spelling two deps edges away
# from the scoped root, so its index needs the verified transitive origin.
cc_library(
    name = "werror_replay_virtual_header",
    testonly = True,
    hdrs = ["scoped_main-group/detail/ReplayValue.h"],
    include_prefix = "aobus-scoped-fixture",
    strip_include_prefix = "scoped_main-group/detail",
    tags = ["manual"],
    visibility = ["//visibility:private"],
)

cc_library(
    name = "werror_replay_inputs",
    testonly = True,
    tags = ["manual"],
    visibility = ["//visibility:private"],
    deps = [":werror_replay_virtual_header"],
)

# The owned warning feature keeps the product's warning promotion in this
# context, so an analysis-only compiler warning exercises the report gate.
# The scoped report test selects just the header; its path exercises all group escapes.
cc_library(
    name = "werror_replay",
    testonly = True,
    srcs = ["scoped_main-group/WerrorReplay.cpp"],
    hdrs = ["scoped_main-group/WerrorReplay.h"],
    tags = ["manual"],
    deps = [
        ":werror_replay_inputs",
        "//bazel:compile_contract",
    ],
)

# The actual native action launcher is data: this test starts it, and the
# lint graph reaches its C++ compile main through the same edge.
replay_launcher_py_test(
    name = "replay_launcher_test",
    size = "small",
    srcs = ["replay_launcher_test.py"],
    args = ["$(rlocationpath //tool/lint:replay_launcher)"],
    data = ["//tool/lint:replay_launcher"],
    tags = ["manual"],
    deps = ["@rules_python//python/runfiles"],
)

# Explicit until each native checker/fixture profile is admitted; raw report
# builds are not a replacement for the portal's per-invocation findings gate.
lint_fixture_test(
    name = "lint_test",
    size = "large",
    timeout = "long",
    tags = [
        "aobus-lint-sdk-host",
        "manual",
    ],
)
