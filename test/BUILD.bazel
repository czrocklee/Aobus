    constraint_values = ["@platforms//cpu:x86_64"],
)

GTK_HEADER_COPTS = select({
    ":gtk_x86_64_cpu": ["-mfpmath=sse", "-msse", "-msse2"],
    "//conditions:default": [],
})

# Match CMake's ao_test_options warning exception; this is not a dependency ABI contract.
TEST_WARNING_COPTS = select({
    "@platforms//os:windows": [],
    "//conditions:default": ["-Wno-array-bounds"],
})

# //lib/audio:test_headers exposes PipeWire's SPA headers transitively on Linux.
# Every compiling consumer, including playback fixtures, needs these local flags.
AUDIO_TEST_COPTS = TEST_WARNING_COPTS + select({
    "@platforms//os:linux": ["-fno-strict-aliasing", "-fno-strict-overflow"],
    "//conditions:default": [],
})

