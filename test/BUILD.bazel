# Common filesystem fixtures used by storage and media cases. Preserve the
# existing test/... includes and Windows access-control dependency without
# pulling library fixtures or fatal-probe objects into the pure media test.
# Under Bazel it also owns the AOBUS_BAZEL_TEST_RUNFILES adapter: the guarded
# region in TestFixtureSupport.cpp is empty in the CMake build, which never
# links the rules_cc runfiles SDK.
cc_library(
    name = "common_test_support",
    testonly = True,
    linkstatic = True,
    srcs = [
        "TestFixtureSupport.cpp",
        "FilesystemTestSupport.cpp",
    ] + select({
        "@platforms//os:windows": ["FilesystemTestSupportWindows.cpp"],
        "//conditions:default": ["FilesystemTestSupportPosix.cpp"],
    }),
    hdrs = [
        "TestFixtureSupport.h",
        "FilesystemTestSupport.h",
    ],
    include_prefix = "test",
    linkopts = select({
        "@platforms//os:windows": ["Advapi32.lib"],
        "//conditions:default": [],
    }),
    local_defines = ["AOBUS_BAZEL_TEST_RUNFILES"],
    strip_include_prefix = ".",
    deps = [
        "//lib/utility:utility",
        "@rules_cc//cc/runfiles",
        "@aobus_test_deps//:catch2",
    ],
)

