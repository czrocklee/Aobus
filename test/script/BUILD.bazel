    "@platforms//os:macos": ["AOBUS_STATE_ROOT"],
    "@platforms//os:windows": _WINDOWS_MANAGED_STATE + [
        "PROCESSOR_ARCHITECTURE",
        "USERPROFILE",
    ],
    "//conditions:default": [],
})

