package(default_visibility = ["//visibility:private"])

# Native WinUI packages these authored assets under its existing SDK resource
# aliases; layout YAML remains owned by the frontend package.
filegroup(
    name = "winui_assets",
    srcs = [
        "brand/LICENSE.txt",
        "brand/SoulMark.svg",
        "ui/no-cover/equalizer.svg",
        "ui/no-cover/note.svg",
        "ui/no-cover/vinyl.svg",
    ],
    visibility = ["//app/windows-winui:__pkg__"],
)

# The AppKit bundle consumes brand/Aobus.icns and brand/LICENSE.txt; no other
# asset rides along into the macOS product graph.
exports_files(
    ["brand/Aobus.icns"],
    visibility = ["//app/macos-appkit:__pkg__"],
)

# GTK resource inventory labels. Membership stays in //app/linux-gtk.
exports_files(
    ["brand/LICENSE.txt"],
    visibility = [
        "//app/linux-gtk:__pkg__",
        "//app/macos-appkit:__pkg__",
    ],
)

exports_files(
    [
        "brand/SoulMark.svg",
        "ui/no-cover/equalizer.svg",
        "ui/no-cover/note.svg",
        "ui/no-cover/vinyl.svg",
    ],
    visibility = ["//app/linux-gtk:__pkg__"],
)
