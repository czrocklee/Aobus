+  const std::string llvm_root = GetMandatoryEnvVar("APPLE_SUPPORT_LLVM_ROOT");
+  if (llvm_root.empty() || llvm_root[0] != '/') {
+    std::cerr << "Error: APPLE_SUPPORT_LLVM_ROOT must be an absolute directory.\n";
+    return 1;
   }
@@ -456,2 +464,3 @@
-  std::vector<std::string> invocation_args = {"/usr/bin/xcrun", tool_name};
