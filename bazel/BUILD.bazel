load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "optimized_contracts",
    values = {"compilation_mode": "opt"},
)

# Runtime contract behavior follows the actual compilation mode. Standalone
# probes share this interface without importing the Core utility header tree.
cc_library(
    name = "compile_contract",
    defines = ["gsl_CONFIG_CONTRACT_CHECKING_ON"] + select({
        ":optimized_contracts": ["gsl_CONFIG_CONTRACT_VIOLATION_TERMINATES"],
        "//conditions:default": ["gsl_CONFIG_CONTRACT_VIOLATION_ASSERTS"],
    }),
)

exports_files([
    "catalog.bzl",
    "compile_context.bzl",
    "compiler_policy.bzl",
    "dependencies.bzl",
    "gperf.bzl",
    "linux_toolchain.bzl",
    "macos_cc_config.bzl",
    "verify_windows_utf8_manifest.ps1",
    "windows_toolchain.bzl",
    "windows_utf8_manifest.bzl",
])
