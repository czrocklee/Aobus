# Primary native product graph; the portal and explicit Bazel commands share it.
load("@rules_python//python:defs.bzl", "py_binary")
load("//bazel:instrumentation_tests.bzl", "instrumentation_tests")
load("//bazel:python_libraries.bzl", "aobus_python_libraries")
load("//bazel:validation.bzl", "native_validation_tests")
load("//bazel/lint:action_sources.bzl", "LINT_ACTION_SOURCES", "LINT_FIXTURE_SOURCES")

package(default_visibility = ["//visibility:public"])

exports_files([
    ".bazelrc",
    ".github/workflows/ci.yml",
    "VERSION.txt",
    "cmake/vcpkg-ports/stb/vcpkg.json",
    "config/bazel/dependencies.json",
    "dependency-contract.json",
    "nixpkgs.json",
    "pyproject.toml",
    "vcpkg.json",
    "vcpkg-configuration.json",
    "script/ao/portal/bazel_resolver.py",
    "script/ao/portal/bazel_environment.py",
    "script/ao/__init__.py",
    "script/ao/core/__init__.py",
    "script/ao/portal/__init__.py",
    "script/ao/portal/bazel_lint_sdk.py",
    "script/ao/policy/__init__.py",
    "script/ao/policy/compiler_policy.py",
    "script/ao/core/paths.py",
    "script/ao/policy/windows_llvm_sdk.py",
    "script/ao/graph/__init__.py",
    "script/ao/graph/bazel_lint_action.py",
    "script/ao/graph/bazel_lint_fixture.py",
    "script/ao/graph/bazel_graph_lint.py",
    "script/ao/graph/bazel_graph_lint_gate.py",
    "script/ao/portal/bazel_native_smoke.py",
    "script/ao/graph/bazel_test_runner.py",
    "script/ao/graph/appkit_process.py",
    "script/ao/windows-llvm-sdk.json",
    "shell.nix",
    "script/ao/macos-toolchain.json",
])

# Declared Python inventory for tooling audits; native actions use narrow inputs.
filegroup(
    name = "ao_python_sources",
    srcs = glob(["script/ao/**/*.py"]) + ["//bazel:compiler_policy.bzl"],
)

# Narrow role and execution libraries share the admitted native Python runtime.
aobus_python_libraries()

py_binary(
    name = "native_test_runner",
    main_module = "ao.graph.bazel_test_runner",
    deps = [":ao_native_test_support"],
)

# The cacheable lint verification and analysis actions import only these
# stdlib-only modules, so other portal edits keep their reports cached.
# test_bazel_lint_action compares this list with the helper's real imports:
# an unsandboxed action would otherwise reuse reports after an undeclared edit.
filegroup(
    name = "ao_lint_action_sources",
    srcs = LINT_ACTION_SOURCES,
)

# The fixture runner takes verified tools and imports no portal preparation.
filegroup(
    name = "ao_lint_fixture_sources",
    srcs = LINT_FIXTURE_SOURCES,
)

# Existing Linux compile-only sanitizer canaries and coverage analysis. These
# do not run sanitizer suites or collect a coverage report.
instrumentation_tests()

# Project-specific native oracles consume folded aspect facts, never runtime Bazel.
native_validation_tests(python = "ao_python_validation")

# Focused test selection; //... also discovers repository checks and native
# process tests. test_suite.tests is non-configurable, so compatibility belongs
# to its members.
test_suite(
    name = "tests",
    tests = [
        "//bazel/header_share:sparse_headers_test",
        "//test:async_test",
        "//test:audio_platform_test",
        "//test:audio_test",
        "//test:cli_test",
        "//test:desktop_test",
        "//test:dictionary_publication_test",
        "//test:i18n_test",
        "//test:library_test",
        "//test:media_fixture_test",
        "//test:media_test",
        "//test:native_process_tests",
        "//test:query_test",
        "//test:runtime_test",
        "//test:systemmedia_test",
        "//test:tui_test",
        "//test:uimodel_test",
        "//test:utility_test",
        "//test:winui_test",
    ],
)

# These groups describe executable ownership, not another source-file inventory.
test_suite(
    name = "portable_core_tests",
    tests = [
        "//test:async_test",
        "//test:audio_platform_test",
        "//test:audio_test",
        "//test:library_test",
        "//test:media_test",
        "//test:query_test",
        "//test:utility_test",
    ],
)

test_suite(
    name = "core_tests",
    tests = [
        ":portable_core_tests",
        "//test:dictionary_publication_test",
    ],
)

test_suite(
    name = "application_tests",
    tests = [
        "//test:desktop_test",
        "//test:i18n_test",
        "//test:media_fixture_test",
        "//test:runtime_test",
        "//test:uimodel_test",
        "//test:winui_test",
    ],
)

# Managed sanitizer tests add the configured check_native_tests backend roots.
# They are scoped instrumentation runs, not the whole completion ownership gate.
test_suite(
    name = "asan_tests",
    tests = [
        ":application_tests",
        ":core_tests",
        "//test:cli_test",
        "//test:gtk_test",
        "//test:systemmedia_test",
        "//test:tui_test",
    ],
)

test_suite(
    name = "tsan_tests",
    tests = [
        ":application_tests",
        ":core_tests",
        "//test:gtk_test",
    ],
)

# Coverage is Linux-only. Keep its executable selection separate from ordinary
# tests, which also contain system-media and omit the backend/headless GTK.
test_suite(
    name = "coverage_core_tests",
    tests = [":core_tests"],
)

test_suite(
    name = "coverage_application_tests",
    tests = [":application_tests"],
)

test_suite(
    name = "coverage_backend_tests",
    tests = ["//test:backend_test"],
)

test_suite(
    name = "coverage_default_tests",
    tests = [
        ":application_tests",
        ":core_tests",
        ":coverage_backend_tests",
    ],
)

test_suite(
    name = "coverage_all_tests",
    tests = [
        ":coverage_default_tests",
        "//test:cli_test",
        "//test:gtk_test",
        "//test:tui_test",
    ],
)

test_suite(
    name = "coverage_tui_tests",
    tests = ["//test:tui_test"],
)

test_suite(
    name = "coverage_cli_tests",
    tests = ["//test:cli_test"],
)

test_suite(
    name = "coverage_gtk_tests",
    tests = ["//test:gtk_test"],
)

test_suite(
    name = "utility_tests",
    tests = ["//test:utility_test"],
)

test_suite(
    name = "library_tests",
    tests = [
        "//test:dictionary_publication_test",
        "//test:library_test",
    ],
)

test_suite(
    name = "query_tests",
    tests = ["//test:query_test"],
)

test_suite(
    name = "async_tests",
    tests = ["//test:async_test"],
)

test_suite(
    name = "uimodel_tests",
    tests = ["//test:uimodel_test"],
)

test_suite(
    name = "cli_tests",
    tests = ["//test:cli_test"],
)

test_suite(
    name = "tui_tests",
    tests = ["//test:tui_test"],
)

test_suite(
    name = "tui_system_media_tests",
    tests = ["//test:systemmedia_test"],
)

test_suite(
    name = "audio_tests",
    tests = [
        "//test:audio_platform_test",
        "//test:audio_test",
    ],
)

test_suite(
    name = "media_tests",
    tests = [
        "//test:media_fixture_test",
        "//test:media_test",
    ],
)

# Explicit suite members retain the unattended native harnesses in wildcard
# validation, including tests whose standalone labels are manual.
test_suite(
    name = "check_tests",
    tests = [
        ":tests",
        "//test:backend_test",
        "//test:gtk_test",
        "//test:lint_test",
    ],
)

# Native backend ownership root for lint and explicit instrumentation tools.
# Its hidden hardware cases remain opt-in.
filegroup(
    name = "check_native_tests",
    testonly = True,
    srcs = ["//test:backend_test"],
)

# Build-only benchmark coverage; no timing acceptance is implied.
filegroup(
    name = "check_benchmarks",
    testonly = True,
    srcs = [
        "//test:ao_perf_baseline",
        "//test:ao_tui_bench",
    ],
)

filegroup(
    name = "check_gui",
    testonly = True,
    srcs = select({
        "@platforms//os:macos": ["//app/macos-appkit:ao_appkit_smoke"],
        "@platforms//os:windows": [
            "//app/windows-winui:ao_winui_activity_status_probe",
            "//app/windows-winui:ao_winui_automation_probe",
            "//app/windows-winui:ao_winui_credits_probe",
            "//app/windows-winui:ao_winui_quality_tooltip_probe",
            "//app/windows-winui:ao_winui_soul_probe",
            "//app/windows-winui:ao_winui_track_table_probe",
        ],
        "//conditions:default": [],
    }),
)

# Existing WinUI console executables reused by the native process tests.
filegroup(
    name = "check_runs",
    testonly = True,
    srcs = select({
        "@platforms//os:windows": [
            "//app/windows-winui:ao_winui_localization_probe",
            "//app/windows-winui:ao_winui_track_item_probe",
        ],
        "//conditions:default": [],
    }),
)

# Unlike test-suite expansion, ordinary dependency edges propagate incompatible
# members. Reuse the portable suites and select the native optional tests here.
filegroup(
    name = "check_cpp_tests",
    testonly = True,
    srcs = [
        ":application_tests",
        ":portable_core_tests",
        "//test:backend_test",
        "//test:cli_test",
        "//test:lint_test",
        "//test:tui_test",
    ] + select({
        "@platforms//os:linux": [
            "//bazel/header_share:sparse_headers_test",
            "//test:dictionary_publication_test",
        ],
        "//conditions:default": [],
    }) + select({
        "//bazel:linux_gtk_enabled": ["//test:gtk_test"],
        "//conditions:default": [],
    }) + select({
        "//bazel:linux_system_media_enabled": ["//test:systemmedia_test"],
        "//conditions:default": [],
    }),
)

# Keep the analysis SDK lazy for bounded product builds. The test package owns
# the lint rule; this public selection alias does not load it until requested.
alias(
    name = "production_lint",
    actual = "//test/lint:production_lint",
)

filegroup(
    name = "check_products",
    testonly = True,
    srcs = [
        ":check_benchmarks",
        ":check_gui",
        ":check_runs",
        "//app/cli:aobus",
        # Builds no file; its analysis enforces the CLI link-closure boundary.
        "//app/cli:link_closure",
        "//app/tui:aobus-tui",
    ] + select({
        "//bazel:linux_gtk_enabled": ["//app/linux-gtk:aobus-gtk"],
        "@platforms//os:macos": ["//app/macos-appkit:aobus-appkit"],
        "@platforms//os:windows": ["//app/windows-winui:aobus-winui"],
        "//conditions:default": [],
    }),
)
