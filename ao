#!/usr/bin/env bash
# Aobus development portal: ./ao <command> [options]
# Enters the native dependency environment, then dispatches to the Python
# package in script/ao. Linux uses Nix; macOS uses Homebrew host tools and a
# repository-pinned vcpkg checkout.
#
# Deliberately does NOT trust IN_NIX_SHELL: direnv and long-lived shells carry stale
# environments that silently diverge from the current shell.nix (e.g. missing pkg-config
# entries for recently added dependencies). The portal re-enters through the pinned
# shell.nix unless the entered shell's AO_NIX_SHELL_FINGERPRINT matches the current
# files and GTK debug mode, and uses its own sentinel to stop the recursion.
# Export AO_IN_NIX_PORTAL=1 yourself only if your shell matches shell.nix exactly.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Resolve repository-relative hook and compiler-cache paths consistently.
cd "$ROOT"

if [[ "$(uname -s)" == "Darwin" ]]; then
    # Do not let Python modules from an ambient virtual environment shadow the
    # portal package. The Homebrew interpreter is selected by the macOS lock.
    unset PYTHONHOME PYTHONPATH
    source "$ROOT/script/ao/macos-vcpkg-bootstrap.sh"
    aobus_macos_prepare_python "$ROOT" || exit $?
    export PYTHONPATH="$ROOT/script"
    AOBUS_PREFLIGHT_SCOPE="$(mktemp "${TMPDIR:-/tmp}/aobus-preflight.XXXXXXXX")"
    export AOBUS_PREFLIGHT_SCOPE
    trap 'rm -f -- "$AOBUS_PREFLIGHT_SCOPE"' EXIT

    NEEDS_BUILD_ENV=0
    NEEDS_PYTHON_TOOLS=0
    if [[ $# -gt 0 ]]; then
        NEEDS_BUILD_ENV="$("$AOBUS_PYTHON" -m ao.core.buildenv "$@")"
        NEEDS_PYTHON_TOOLS="$("$AOBUS_PYTHON" -m ao.core.buildenv --python-tools "$@")"
    fi
    if [[ "$NEEDS_PYTHON_TOOLS" == "1" ]]; then
        aobus_macos_prepare_python_tools "$ROOT" || exit $?
    fi
    if [[ "$NEEDS_BUILD_ENV" == "1" ]]; then
        aobus_macos_prepare_build_environment "$ROOT" || exit $?
    fi
    "$AOBUS_PYTHON" -m ao "$@"
    exit $?
fi

# The same inputs and hashing as portalFingerprint in shell.nix.
aobus_nix_shell_fingerprint() {
    local input
    {
        for input in shell.nix nixpkgs.json script/ao/toolchain.json script/ao/compiler-cache.json; do
            sha256sum "$ROOT/$input" | cut -c1-64
        done
        if [[ "${AOBUS_NIX_UNSTRIPPED_GTK:-}" == "1" ]]; then
            printf 'gtk-unstripped=1\n'
        else
            printf 'gtk-unstripped=0\n'
        fi
    } | sha256sum | cut -c1-64
}

# An entered shell (direnv, CI) built from the current inputs is not stale.
# Reuse it: nesting nix-shell appends a second copy of NIX_CFLAGS_COMPILE,
# NIX_LDFLAGS, and CPLUS_INCLUDE_PATH to every compiler invocation.
if [[ -z "${AO_IN_NIX_PORTAL:-}" && -n "${AO_NIX_SHELL_FINGERPRINT:-}" &&
      -n "${AO_NIX_PORTAL_PYTHON:-}" &&
      "$AO_NIX_SHELL_FINGERPRINT" == "$(aobus_nix_shell_fingerprint)" ]]; then
    AO_IN_NIX_PORTAL=1
fi

if [[ -z "${AO_IN_NIX_PORTAL:-}" ]]; then
    # Do not let Python modules from a previously entered project shell shadow
    # the versions selected by the current shell.nix.
    unset PYTHONHOME PYTHONPATH
    # nix-shell otherwise resolves its launch Bash through ambient <nixpkgs>.
    # A host Bash also prepends its directory (often /usr/bin) ahead of pinned
    # tools, so resolve the launch shell from the same project dependency pin.
    if [[ -z "${NIX_BUILD_SHELL:-}" ]]; then
        NIX_BUILD_SHELL="$(nix-build "$ROOT/shell.nix" -A portalShell --no-out-link)/bin/bash"
        export NIX_BUILD_SHELL
    fi
    exec nix-shell "$ROOT/shell.nix" --run "AO_IN_NIX_PORTAL=1 $(printf '%q ' "$ROOT/ao" "$@")"
fi

# Reuse must not adopt a subsequently activated virtualenv or ambient packages.
# The Nix Python environment carries Ruff and mypy without ambient PYTHONPATH.
unset PYTHONHOME PYTHONPATH
export PYTHONPATH="$ROOT/script"
exec "${AO_NIX_PORTAL_PYTHON:-python3}" -m ao "$@"
