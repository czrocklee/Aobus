#!/usr/bin/env bash
# Aobus development portal: ./ao <command> [options]
# Re-enters nix-shell, then dispatches to the Python package in script/ao.
#
# Deliberately does NOT trust IN_NIX_SHELL: direnv and long-lived shells carry stale
# environments that silently diverge from the current shell.nix (e.g. missing pkg-config
# entries for recently added dependencies). The portal always re-enters through the
# pinned shell.nix and uses its own sentinel to stop the recursion; export
# AO_IN_NIX_PORTAL=1 yourself only if you know your shell matches shell.nix exactly.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# cd first so shell.nix's $PWD-based hooks (ccache dir) resolve to the repository.
cd "$ROOT"

if [[ -z "${AO_IN_NIX_PORTAL:-}" ]]; then
    # Do not let Python modules from a previously entered project shell shadow
    # the versions selected by the current shell.nix.
    unset PYTHONHOME PYTHONPATH
    # macOS ships bash 3.2.57, which nixpkgs' stdenv setup rejects. nix-shell
    # picks its interactive shell from PATH, so resolve the pinned bash first.
    # Non-interactive SSH shells commonly omit Nix's profile from PATH; recover
    # the standard multi-user and legacy single-user locations before invoking
    # either nix-build or nix-shell.
    if [[ "$(uname -s)" == "Darwin" ]]; then
        source "$ROOT/script/ao/darwin-nix-bootstrap.sh"
        aobus_require_nix_build \
            /nix/var/nix/profiles/default/bin \
            "$HOME/.nix-profile/bin" || exit $?
    fi

    if [[ "$(uname -s)" == "Darwin" && -z "${NIX_BUILD_SHELL:-}" ]]; then
        NIX_BUILD_SHELL="$(nix-build --no-out-link "$ROOT/darwin-bash.nix")/bin/bash"
        export NIX_BUILD_SHELL
    fi
    exec nix-shell "$ROOT/shell.nix" --run "AO_IN_NIX_PORTAL=1 $(printf '%q ' "$ROOT/ao" "$@")"
fi

export PYTHONPATH="$ROOT/script${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m ao "$@"
