#!/usr/bin/env bash
# Aobus development portal: ./ao <command> [options]
# Enters the native dependency environment, then dispatches to the Python
# package in script/ao. Linux uses Nix; macOS uses Homebrew host tools and a
# repository-pinned vcpkg checkout.
#
# Deliberately does NOT trust IN_NIX_SHELL: direnv and long-lived shells carry stale
# environments that silently diverge from the current shell.nix (e.g. missing pkg-config
# entries for recently added dependencies). The portal always re-enters through the
# pinned shell.nix and uses its own sentinel to stop the recursion; export
# AO_IN_NIX_PORTAL=1 yourself only if you know your shell matches shell.nix exactly.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Resolve repository-relative hook and compiler-cache paths consistently.
cd "$ROOT"

aobus_configure_git_hooks() {
    if [[ -d "$ROOT/.git" ]]; then
        git -C "$ROOT" config --local core.hooksPath script/git-hook
    fi
}

if [[ "$(uname -s)" == "Darwin" ]]; then
    # Do not let Python modules from an ambient virtual environment shadow the
    # portal package. The Homebrew interpreter is selected by the macOS lock.
    unset PYTHONHOME PYTHONPATH
    source "$ROOT/script/ao/macos-vcpkg-bootstrap.sh"
    aobus_macos_prepare_python "$ROOT" || exit $?
    aobus_configure_git_hooks
    export PYTHONPATH="$ROOT/script"

    NEEDS_BUILD_ENV=0
    NEEDS_PYTHON_TOOLS=0
    if [[ $# -gt 0 ]]; then
        NEEDS_BUILD_ENV="$("$AOBUS_PYTHON" -m ao.core.buildenv "$@")"
        NEEDS_PYTHON_TOOLS="$("$AOBUS_PYTHON" -m ao.core.buildenv --python-tools "$@")"
    fi
    if [[ "$NEEDS_PYTHON_TOOLS" == "1" ]]; then
        aobus_macos_prepare_python_tools "$ROOT" || exit $?
    fi
    if [[ "$NEEDS_BUILD_ENV" == "1" ]]; then
        aobus_macos_prepare_build_environment "$ROOT" || exit $?
    fi
    exec "$AOBUS_PYTHON" -m ao "$@"
fi

if [[ -z "${AO_IN_NIX_PORTAL:-}" ]]; then
    # Do not let Python modules from a previously entered project shell shadow
    # the versions selected by the current shell.nix.
    unset PYTHONHOME PYTHONPATH
    exec nix-shell "$ROOT/shell.nix" --run "AO_IN_NIX_PORTAL=1 $(printf '%q ' "$ROOT/ao" "$@")"
fi

aobus_configure_git_hooks
export PYTHONPATH="$ROOT/script${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m ao "$@"
